# This file is read by systemd, not by the public web server.
APP_ENV=production
FLASK_DEBUG=false
DATABASE_URL=
SECRET_KEY=
# Keep the existing key if reusing a database containing saved VPS credentials.
VPS_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=true
BEHIND_PROXY=true
TRUSTED_HOSTS=vps-monitor.net
AUTO_CREATE_TABLES=false
MAX_VPS_PER_USER=10
SSH_ALLOWED_PORTS=22
