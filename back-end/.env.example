# Local development. Never commit real credentials here.
APP_ENV=development
FLASK_APP=app
FLASK_DEBUG=false
PORT=5000
DATABASE_URL=postgresql://vps_monitor:CHANGE_ME@db.example.com:5432/vps_monitor?sslmode=verify-full
SECRET_KEY=
VPS_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
BEHIND_PROXY=false
TRUSTED_HOSTS=
MAX_VPS_PER_USER=10
SSH_ALLOWED_PORTS=
